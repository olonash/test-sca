{
  "name": "scal-e/cdp-backend",
  "description": "Customer Data Platform backend for Scal-e technical test",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mysqlnd": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "ScalE\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ScalE\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "start": "php -S 0.0.0.0:8000 -t public"
  }
}
